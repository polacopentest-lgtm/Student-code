5. Detectar automaticamente arquivos repetidos

Uma função simples:

PowerShell
function Test-LogDuplicado {
 
param(
[string]$ArquivoAtual,
[string]$Pasta
)
 
$HashAtual =
(Get-FileHash $ArquivoAtual -Algorithm SHA256).Hash
 
Get-ChildItem $Pasta -File |
ForEach-Object {
 
if ($_.FullName -ne $ArquivoAtual) {
 
$Hash =
(Get-FileHash $_.FullName -Algorithm SHA256).Hash
 
if ($Hash -eq $HashAtual) {
 
Write-Host ""
Write-Host "ARQUIVO DUPLICADO ENCONTRADO" -ForegroundColor Yellow
 
Write-Host $_.Name
}
}
}
}
