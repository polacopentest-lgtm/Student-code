Clear-Host

# 1. Solicita a string do MID diretamente ao usuário
Write-Host "--------------------------------------------------------" -ForegroundColor Yellow
$Mensagem = Read-Host "👉 Cole ou digite a sequência do MID 0035 aqui"
Write-Host "--------------------------------------------------------" -ForegroundColor Yellow

# Remove espaços em branco nas pontas, se houver
$Mensagem = $Mensagem.Trim()

# Validação básica de tamanho para evitar erros no corte
if ($Mensagem.Length -lt 42) {
    Write-Host "❌ Erro: A sequência informada é muito curta para ser um MID 0035 válido." -ForegroundColor Red
    Write-Host "Certifique-se de colar a string completa, incluindo o cabeçalho inicial." -ForegroundColor Gray
    Exit
}

try {
    # 2. Extração de dados usando posições fixas (Substrings baseadas no Open Protocol)
    # No PowerShell, o índice da string começa no caractere 0
    $Comprimento = $Mensagem.Substring(0, 4)
    $MID         = $Mensagem.Substring(4, 4)
    $Revisao     = $Mensagem.Substring(8, 3)

    # Corpo de dados úteis (conforme as tabelas do Power Focus 4000)
    $JobID       = $Mensagem.Substring(22, 2)
    $StatusCode  = $Mensagem.Substring(26, 1)
    $ModeCode    = $Mensagem.Substring(29, 1)
    $BatchSize   = [int]$Mensagem.Substring(32, 4)
    $Counter     = [int]$Mensagem.Substring(38, 4)

    # 3. Interpretação dos códigos com base nas tabelas do manual
    $StatusTexto = switch ($StatusCode) {
        "0" { "0 (Job não completado / Em andamento)" }
        "1" { "1 (Job concluído com sucesso - OK)" }
        "2" { "2 (Job reprovado - NOK)" }
        default { "$StatusCode (Desconhecido)" }
    }

    $ModoTexto = switch ($ModeCode) {
        "0" { "0 (Apenas os apertos OK são contados)" }
        "1" { "1 (Ambos os apertos OK e NOK são contados)" }
        default { "$ModeCode (Desconhecido)" }
    }

    # 4. Exibição do relatório formatado na tela
    Write-Host ""
    Write-Host "================== DETALHES DO MID 0035 ==================" -ForegroundColor Cyan
    Write-Host "📋 CABEÇALHO DO PROTOCOLO:"
    Write-Host "   • Tamanho Total: $Comprimento caracteres"
    Write-Host "   • Tipo do MID:   $MID"
    Write-Host "   • Revisão:       $Revisao"
    Write-Host ""
    Write-Host "🔩 DADOS DE PRODUÇÃO (POWER FOCUS 4000):"
    Write-Host "   • ID do Job:      $JobID"
    Write-Host "   • Status do Job:  $StatusTexto"
    Write-Host "   • Modo do Lote:   $ModoTexto"
    Write-Host "   • Meta do Lote:   $BatchSize parafusos"
    Write-Host "   • Progresso Atual: $Counter parafusos apertados"
    Write-Host "==========================================================" -ForegroundColor Cyan
}
catch {
    Write-Host "❌ Ocorreu um erro ao processar a string. Verifique se o formato enviado está correto." -ForegroundColor Red
}
