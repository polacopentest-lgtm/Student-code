@($Apertos | Where-Object { $_.Status -ne '1' })
    $vins = @($Apertos | Select-Object -ExpandProperty VIN -Unique)
    $tq = $Apertos | Measure-Object -Property Torque -Minimum -Maximum -Average
    Write-Host ("  Apertos: {0}  (OK {1} | NOK {2})  |  VINs distintos: {3}" -f $Apertos.Count, $ok, $nok.Count, $vins.Count)
    Write-Host ("  Torque: minimo {0} | medio {1} | maximo {2} Nm" -f (Fmt $tq.Minimum 2), (Fmt $tq.Average 2), (Fmt $tq.Maximum 2))
    Write-Host "  Apertos por hora:" -ForegroundColor Gray
    $Apertos | Group-Object { $_.Hora.Hour } | Sort-Object { [int]$_.Name } | ForEach-Object {
        Write-Host ("    {0:00}h : {1}" -f [int]$_.Name, $_.Count)
    }
    if ($nok.Count -gt 0) {
        Write-Host "  Apertos NOK:" -ForegroundColor Yellow
        foreach ($n in $nok) {
            Write-Host ("    {0:HH:mm:ss}  VIN {1}  Job {2} PSet {3}  torque {4} Nm ({5})  angulo {6} ({7})" -f $n.Hora, $n.VIN, $n.Job, $n.PSet, (Fmt $n.Torque 2), $StatusLimite[$n.StTorque], $n.Angulo, $StatusLimite[$n.StAngulo]) -ForegroundColor Yellow
        }
    }
